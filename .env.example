# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Admin Passcode Override (leave empty to claim first-run admin in UI)
ADMIN_PASSCODE=

# Ethiopian Payment Provider Credentials (configure before enabling live payments)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=

# Optional SMS / Email Delivery Provider
SMS_API_KEY=
SMTP_URL=
